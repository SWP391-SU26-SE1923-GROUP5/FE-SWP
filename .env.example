# =============================================================================
# SmartStore Front-end – example environment variables
# Copy to `.env.local` and fill in real values for local development.
# =============================================================================

AUTH_SECRET=local_development_secret_only

DATABASE_URL="postgresql://postgres:smartdbpassword123@localhost:5432/smartstore"
MINIO_ENDPOINT="http://localhost:9000"
MINIO_ACCESS_KEY="admin"
MINIO_SECRET_KEY="smartstorepassword123"
MINIO_BUCKET_NAME="smartstore-files"

OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_EMBEDDING_MODEL="mxbai-embed-large"
OLLAMA_CHAT_MODEL="llama3"

QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""

# -----------------------------------------------------------------------------
# Admin Front-end Module
# Comma-separated list of emails that should be promoted to the admin role on
# sign-up.  After updating this list, sign up with one of the emails (or
# change your existing user's role to 'admin' directly in the database) to
# access the /admin console.
# -----------------------------------------------------------------------------
ADMIN_EMAILS="admin@smartstore.local"
